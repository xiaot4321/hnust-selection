# Copy to .env on the server. Single-quote secrets containing $ or #.
MYSQL_ROOT_PASSWORD='replace-with-a-long-random-root-password'
DB_PASSWORD='replace-with-a-different-long-random-app-password'
APP_VERSION=local
HTTP_PORT=8088
HTTPS_PORT=443
SESSION_COOKIE_SECURE=true

# Optional services: required for resume/avatar uploads and email recovery.
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_BUCKET=hnust-selection
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
